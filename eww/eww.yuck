(defwindow launcher_controlls :stacking "bg" :monitor 0 :focusable "false" :screen 1
  :geometry (geometry
		:y 5
		:x 0
		:width 18
		:anchor "top right"
	)

  (box :orientation "v" :class "launchers-items"
       :spacing 0

    (button
      :onclick "pamixer -i 5"
      "")

    (button
      "")

    (button
      :onclick "pamixer -d 5"
      "")

    (button
      " ")


    (button
      :onclick "brightnessctl set 5%+"
      "")

    (button
      "󰃟")

    (button
      :onclick "brightnessctl set 5%-"
      "")


    (button
      " ")


    (button
      :onclick "run_gamma_up"
      "")

    (button
      :onclick "run_gamma_reset"
      "")

    (button
      :onclick "run_gamma_down"
      "")


    (button
      " ")



    (button
      :onclick "run_temp_up"
      "")

    (button
      :onclick "run_temp_reset"
      "")

    (button
      :onclick "run_temp_down"
      "")





  )
)


;; -- -- --

(defwindow launcher_apps_right :stacking "fg" :monitor 0 :focusable "false" :screen 1
  :geometry (geometry
		:y 10
		:x 0
		:width 18
    :exclusive false
    :wm-ignore true
		:anchor "bottom right"
	)

  (box :orientation "v"  :class "launcher-items"
       :spacing 30

			;; vpn throne
    (button
      :onclick "throne &"
      "")
			;; browser service
    (button
      :onclick "run_toggle_tor &"
      "")
			;; vnc server
    (button
      :onclick "run_toggle_vnc &"
      "󰦉")
			;; ssh
    (button
      :onclick "run_toggle_ssh %"
      "󰆍")
			;; ftp
    (button
      :onclick "run_toggle_ftp &"
      "")
			;; touch server
    (button
      :onclick "run_toggle_touchserver &"
      "󰈷")
			;; color picker
    (button
      :onclick "run_color_picker &"
      "")
		;; waypaper wallpaper manager
    (button
      :onclick "waypaper &"
      "󰸉")
		;; bluetooth manager
    (button
      :onclick "blueman-manager &"
      "")
		;; galculator
    (button
      :onclick "galculator &"
      "󰪚")
		;; scrcpy script ** TODO
		;; pomotroid
    (button
      :onclick "pomotroid &"
      "")
		;; sniffnet
    (button
      :onclick "sniffnet &"
      "󰀂")

  )
)



(defwindow launcher_apps_left :stacking "bg" :monitor 0 :focusable "false" :screen 1
  :geometry (geometry
		:x 0
		:width 18
		:anchor "center left"
	)

  (box :orientation "v"  :class "launchers-items"
       :spacing 30

			 ;; launcher
    (button
      :onclick "run_wmenu"
      "")

			 ;; launcher + icons
    (button
      :onclick "run_rofi"
      "")

			 ;; wiki arch
    (button
      :onclick "run_wikiarch"
      "󰖬")

			;; code editor
    (button
      :onclick "code &"
      "")

			;; emacs
    (button
      :onclick "emacs &"
      "")

			;; download manager uget
    (button
      :onclick "uget-gtk &"
      "")

			;; browser firefox
    (button
      :onclick "firefox &"
      "")

			;; browser tor
    (button
      :onclick "tor-browser &"
      "")



			;; obsidian
    (button
      :onclick "obsidian &"
      "")

			;; steam
    (button
      :onclick "steam &"
      "")

			;; file browser thunar
    (button
      :onclick "thunar &"
      "")


  )
)




