;; ** Widgets ***********************************************************************




(
	defwidget time_stack_f []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_f" :style "background-image: url('/home/arc/.config/clockimgs/frames/frame.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)
(
	defwidget time_stack_ff []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_f" :style "background-image: url('/home/arc/.config/clockimgs/frames/fframe.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)
(
	defwidget time_stack_fff []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_f" :style "background-image: url('/home/arc/.config/clockimgs/frames/ffframe.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)

(
	defwidget time_stack_h []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_h" :style "background-image: url('/home/arc/.config/clockimgs/hms/h/h-54.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)
(
	defwidget time_stack_m []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_m" :style "background-image: url('/home/arc/.config/clockimgs/hms/m/m-57.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)


(
	defwidget time_stack_s []
		(
			box :class "clock-stack" :orientation "stack"
				(box :class "time_stack_s" :style "background-image: url('/home/arc/.config/clockimgs/hms/s/s-22.png');"
					 :class "face" :halign "center"
					 (label :text "" :halign "center" :width CLOCK_SIZE))

		)
)


(defvar CLOCK_SIZE "200")

;; ** Windows ***********************************************************************


(
	defwindow time_stack_window_s :stacking "bg" :monitor 0 :focusable "false" :screen 1
	:geometry (geometry :x 1547 :y 0 :width 350 :height 350)
	(time_stack_s)
)
(
	defwindow time_stack_window_h :stacking "bg" :monitor 0 :focusable "false" :screen 1
	:geometry (geometry :x 1547 :y 0 :width 350 :height 350)
